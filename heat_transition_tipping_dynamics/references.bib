@article{baleHarnessingSocialNetworks2013,
	title = {Harnessing social networks for promoting adoption of energy technologies in the domestic sector},
	volume = {63},
	issn = {0301-4215},
	url = {https://www.sciencedirect.com/science/article/pii/S0301421513009579},
	doi = {10.1016/j.enpol.2013.09.033},
	abstract = {This paper presents results from modelling work investigating the effects of social networks on the adoption of energy technologies in the domestic sector. This work concerns ideas on social network interventions which have been successfully applied in other domains but which have seldom been applied to energy policy questions. We employ a dynamical multi-parameter network model where households are represented as nodes on a network for which the uptake of technologies is influenced by both personal benefit and social influences. This is applied to demonstrate the usefulness of this type of model in assessing the likely success of different roll-out strategies that a local authority could pursue in promoting the uptake of domestic energy technologies. Local authorities can play a key role in the retrofit of energy-efficiency and low-carbon energy-generation technologies in order to realise carbon reductions and alleviate fuel poverty. Scenarios are modelled for different local authority interventions that target network interactions and uptake threshold effects, and the results provide insights for policy. The potential for the use of this type of modelling in understanding the adoption of energy innovations in the domestic sector and designing local-level interventions is demonstrated.},
	urldate = {2025-08-20},
	journal = {Energy Policy},
	author = {Bale, Catherine S. E. and McCullen, Nicholas J. and Foxon, Timothy J. and Rucklidge, Alastair M. and Gale, William F.},
	month = dec,
	year = {2013},
	keywords = {Domestic sector retrofit, Energy efficiency, Local authorities, Modelling, Residential, Social networks},
	pages = {833--844},
}

@article{baiardiClimateChangeAwareness2021,
	title = {Climate change awareness: {Empirical} evidence for the {European} {Union}},
	volume = {96},
	issn = {0140-9883},
	shorttitle = {Climate change awareness},
	url = {https://www.sciencedirect.com/science/article/pii/S0140988321000682},
	doi = {10.1016/j.eneco.2021.105163},
	abstract = {In this paper, we assess public attitudes on climate change in Europe over the last decade. Using aggregate figures from the Special Eurobarometer surveys on Climate Change, we find that environmental concern is directly related to per capita income, social trust, secondary education, the physical distress associated with hot weather, media coverage, the share of young people in the total population, and monetary losses caused by extreme weather episodes. It is also inversely related to greenhouse gas emissions, relative power position of right-wing parties in government and tertiary education. Moreover, we find a significant, opposite impact for two dummies for years 2017 and 2019, which we respectively associate with the effects of Donald Trump’s denial campaigns and the U.S. Paris Agreement withdrawal announcement, and Greta Thunberg’s environmental activism.},
	urldate = {2025-08-20},
	journal = {Energy Economics},
	author = {Baiardi, Donatella and Morana, Claudio},
	month = apr,
	year = {2021},
	keywords = {Climate change, EU, Environmental attitudes/concern, Mitigation policy},
	pages = {105163},
}

