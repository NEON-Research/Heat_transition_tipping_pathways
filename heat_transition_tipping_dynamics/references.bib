	author = {Dicks, Andrew L. and Rand, David. A. J.},
	year = {2018},
	keywords = {combined-cycle system, electrochemical performance, metal components, molten carbonate fuel cell, planar designs, solid oxide fuel cell, stacking arrangements},
	pages = {235--261},
}

@incollection{dicksProtonExchangeMembraneFuel2018,
	title = {Proton-{Exchange} {Membrane} {Fuel} {Cells}},
	isbn = {978-1-118-70699-2},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118706992.ch4},
	doi = {10.1002/9781118706992.ch4},
	abstract = {The proton-exchange membrane fuel cell (PEMFC) is the most widely known version of acid fuel cell. In all applications, the three most important distinguishing features of PEMFCs are the type of electrolyte, the electrode structure, and the catalyst. The inherent proton conductivity of acid-doped polybenzimidazol (PBI) is very low, but it is easily doped with strong acids to form a single-phase polymer electrolyte with high conductivity. The nature of the electrolyte may differ according to the operating temperature of the stack. All the systems employ stacks that operate with approximately ambient air pressure and use pure hydrogen as the fuel and air as the oxidant. A unitized regenerative fuel cell (URFC) is a reversible cell that is able to operate as a conventional fuel cell and, in regenerative mode, as an electrolyser. The chapter describes water management, which is more complex than that for the PEMFC.},
	language = {en},
	urldate = {2018-12-05},
