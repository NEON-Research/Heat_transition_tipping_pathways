	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118706992.ch9},
	doi = {10.1002/9781118706992.ch9},
	abstract = {The solid oxide fuel cell (SOFC) is similar to the molten carbonate fuel cell (MCFC) in that a negatively charged ion is transferred from the cathode through the electrolyte to the anode. A key issue with SOFCs, particularly planar configurations, is the method of sealing the ceramic and metal components to obtain gas tightness. Unlike tubular cells, however, planar designs require high-temperature gas-tight seals between the components in the SOFC stack. A particular problem associated with the use of glass seals is the migration of silica from the glass, especially onto the anodes with resultant degradation in cell performance. Development of the SOFC escalated in the 1960s with the introduction of the tubular design by Westinghouse Electric Corporation. For SOFC–combined-cycle and hybrid systems, it is beneficial to maintain a high operating temperature.},
	language = {en},
	urldate = {2018-12-05},
