@incollection{hubacekParticipatoryModeling2017,
	title = {Participatory {Modeling}},
	copyright = {Copyright © 2017 John Wiley \& Sons, Ltd.},
	isbn = {978-1-118-78635-2},
	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118786352.wbieg0293},
	doi = {10.1002/9781118786352.wbieg0293},
	abstract = {Participatory modeling (PM) links science and modeling to stakeholder knowledge and experiences, thus supporting and enabling participatory decision-making when dealing with complex social-ecological problems. Whereas traditional model building emphasizes expert-driven collection of information, PM emphasizes collective deliberation, where learning outcomes emerge from ongoing discussions. Stakeholder involvement can range from simply providing information, that is, “knowledge transfer,” to consultation to “collaborative model building.” Here, stakeholders engage in collective problem framing, priority setting, option formulation, and model evaluation. Models are coproduced in an iterative learning process between modelers and stakeholders. This entry summarizes the history of PM and different approaches of stakeholder involvement for model building and social learning.},
	language = {en},
	urldate = {2023-08-25},
	booktitle = {International {Encyclopedia} of {Geography}},
	publisher = {John Wiley \& Sons, Ltd},
	author = {Hubacek, Klaus and Ravera, Federica and Tarrasón, David and Prell, Christina},
	year = {2017},
	note = {\_eprint: https://onlinelibrary.wiley.com/doi/pdf/10.1002/9781118786352.wbieg0293},
	keywords = {community, computational methods, democracy, environment, human–environment interaction, sustainable development},
	pages = {1--8},
}

