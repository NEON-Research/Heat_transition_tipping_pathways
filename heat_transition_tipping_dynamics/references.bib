@incollection{wieczorekEnergyCommunitiesAlternative2023,
	title = {Energy communities as an alternative way of organizing the energy system in {Europe}: key societal aspects},
	shorttitle = {Energy communities as an alternative way of organizing the energy system in {Europe}},
	abstract = {The European energy system is undergoing transformation due to the climate crisis, advancing digitalization, and the increasing demand for greater citizen engagement. Energy communities are recognized as crucial catalysts for the transition towards sustainable energy. While the communities have for long focused on collective generation only, recently they are increasingly involved in new activities, such as providing, distributing, and balancing energy and flexibility. By doing so, energy communities are not only becoming a new actor in the energy system, but they also offer an alternative way of organising it based on the need for independence from the energy suppliers, social cohesion, or support to the local economy. However, the current energy system operates predominantly in a top-down, central way with large power units, transmission, and distribution operators. Market participation is based on high liquidity levels, professionalisation and large volumes that communities do not have and, mostly, do not want. For communities, this implies the necessity to deal with many barriers and challenges. To make space for energy communities, therefore changes are necessary in the organisation of the current energy system. In this chapter, we investigate the energy communities as a new form of organising the European energy system and we analyse how the current energy system provides obstacles to their greater upscaling. We focus on gathering insights about societal aspects that facilitate energy communities as they make their way to the larger system and offer a novel alternative that is more democratic and just.},
	booktitle = {Integrated {Local} {Energy} {Communities}: from the concept and enabling conditions to the optimal planning and operation},
	publisher = {Wiley},
	author = {Wieczorek, Anna J. and van Bommel, Natascha and El Feiaz, Amira and Kluskens, Nikki and Niet, Irene A. and van Summeren, Luc F.M. and Höffken, Johanna I. and Alkemade, Floor and Van den Berghe, Laura H.G.J. and Meloni, Claudia and Graditti, Giorgio and Di Somma, Marialaura},
	editor = {Kok, Koen and Papadimitriou, Christina and Di Somma, Marialaura},
	year = {2023},
	keywords = {acceptance, actors, energy communities, justice, market, transition},
}

@article{wilsonModelsDecisionMaking2007,
	title = {Models of {Decision} {Making} and {Residential} {Energy} {Use}},
	volume = {32},
	issn = {1543-5938, 1545-2050},
	url = {https://www.annualreviews.org/content/journals/10.1146/annurev.energy.32.053006.141137},
	doi = {10.1146/annurev.energy.32.053006.141137},
	abstract = {Research traditions across the social sciences have explored the drivers of individual behavior and proposed different models of decision making. Four diverse perspectives are reviewed here: conventional and behavioral economics, technology adoption theory and attitude-based decision making, social and environmental psychology, and sociology. The individual decision models in these traditions differ axiomatically. Some are founded on informed rationality or psychological variables, and others emphasize physical or contextual factors from individual to social scales. Each perspective suggests particular lessons for designing interventions to change behavior. Throughout the review, these lessons are applied to decisions affecting residential energy use. Examples are drawn from both intuitive and reasoning-based types of decision as well as from a range of decision contexts that include capital investments in weatherization and repetitive behaviors such as appliance use. Areas of difference and similarity between various theoretical approaches and their practical implications are highlighted. Conclusions are drawn on how to develop a more integrated approach to both behavioral research and intervention design in a residential energy context.},
	language = {en},
	number = {Volume 32, 2007},
	urldate = {2024-06-24},
	journal = {Annual Review of Environment and Resources},
	publisher = {Annual Reviews},
	author = {Wilson, Charlie and Dowlatabadi, Hadi},
	month = nov,
	year = {2007},
	pages = {169--203},
}

