	url = {http://www.iaee.org/en/publications/ejarticle.aspx?id=2546},
	doi = {10.5547/01956574.35.1.1},
	abstract = {Modeling of technological change has been a major empirical and anal stacle for many years. One approach to modeling technology is learn perience curves, which originated in techniques used to estimate cost in manufacturing. These have recently been introduced in policy models and climate-change economics to make the process of technological c dogenous—that is, allow technologies to vary with economic conditions widely appreciated that using learning in modeling raises major pote lems. The present note has three points. First, it shows that there is a fun statistical identification problem in trying to separate learning from technological change and that the estimated learning coefficient will ge biased upwards. Second, we present two empirical tests that illustrate th bias in practice and show that learning parameters are not robust to a specifications. Finally, we show that an overestimate of the learning c will provide incorrect estimates of the total marginal cost of output therefore bias optimization models to tilt toward technologies that are specified as having high learning coefficients.},
	language = {en},
	number = {1},
	urldate = {2021-10-28},
	journal = {The Energy Journal},
	author = {Nordhaus, William D.},
	month = jan,
	year = {2014},
}

