	url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/9781118706992.ch3},
	doi = {10.1002/9781118706992.ch3},
	abstract = {This chapter examines the factors that are responsible for the voltage falling below the reversible value and considers the ways to ameliorate their adverse effects. When a fuel cell is put to use, it is found that the ‘operational voltage’ is less than 1.2 V, indeed often considerably less. The accumulation of positive charge on the surface of the cathode as a result of the migrated H+ ions and a relatively lower charge in the surrounding electrolyte results in the formation of an electrical double-layer. The chapter presents voltage versus current density performance of a single cell of typical design and operating at 40 °C and normal air pressure. The characteristic shape of the voltage versus current density relationships is the result of four major irreversibilities: activation losses, internal currents and fuel crossover, ohmic losses, concentration or mass-transport losses.},
	language = {en},
	urldate = {2018-12-05},
