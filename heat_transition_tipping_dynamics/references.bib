@article{singhEnergyTransitionsIndex2019,
	title = {The energy transitions index: {An} analytic framework for understanding the evolving global energy system},
	volume = {26},
	issn = {2211-467X},
	shorttitle = {The energy transitions index},
	url = {http://www.sciencedirect.com/science/article/pii/S2211467X19300756},
	doi = {10.1016/j.esr.2019.100382},
	abstract = {The question of how to enable an effective, modern, global energy transition is garnering significant interest in both academic and policy making communities. Composite statistical indices have emerged as a useful class of tools to offer policymakers additional insights into the state and trajectory of energy transitions around the world. In this commentary, we discuss the purpose of energy indices in general and document several prominent examples. We then introduce and place in this landscape the World Economic Forum's Energy Transitions Index (ETI). The ETI is a tool for energy decision makers that strives to be a comprehensive, global index that tracks the performance of energy systems at the country level. It also incorporates macroeconomic, institutional, social, and geopolitical considerations that provide enabling conditions for an effective energy transition. In this way, the ETI enables a better understanding of the past and present states of energy transition around the world, leading to more informed energy transition policies and investment decisions.},
	language = {en},
	urldate = {2020-10-02},
	journal = {Energy Strategy Reviews},
	author = {Singh, Harsh Vijay and Bocca, Roberto and Gomez, Pedro and Dahlke, Steve and Bazilian, Morgan},
	month = nov,
	year = {2019},
	keywords = {Energy development, Energy index, Energy security, Energy sustainability, Energy transition},
	pages = {100382},
}

