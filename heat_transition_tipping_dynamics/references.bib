@article{loomansExploringTradeoffsDecisionsupport2024,
	title = {Exploring trade-offs: {A} decision-support tool for local energy system planning},
	volume = {369},
	issn = {0306-2619},
	shorttitle = {Exploring trade-offs},
	url = {https://www.sciencedirect.com/science/article/pii/S0306261924009103},
	doi = {10.1016/j.apenergy.2024.123527},
	abstract = {Policymakers are in a balancing act when creating local energy transition strategies. Embedding new technologies in an existing energy system is highly complex. Policymakers must deal with multi-system interactions such as sector coupling, multi-scale effects such as bottom-up behavior and top-down policies, and requirements from local spatial planning, grid constraints, and resource availability. Decision support tools can help to navigate this complex landscape. This paper showcases a tool to support policymakers with heating strategies for Dutch neighborhoods. The tool is a GIS-based simulation model of the energy system developed using a collaborative approach and applied in a scenario study. Energy calculations are done over a year with an hourly resolution, while scenarios can include any future energy system configuration. The results highlight trade-offs between heating strategies, interaction effects with the mobility and electricity transitions, and bottlenecks in transition pathways. Collective district heating has less grid impact but higher emissions and costs, while individual (hybrid) heat pumps have lower emissions and costs but more grid impact. No-regrets and enabling technologies are insulation and smart charging of electric vehicles and boilers. Collaborative modeling with a GIS-based user-interface increases system understanding, including trade-offs, transition pathways, and bottlenecks, in a collective and interactive way. This creates a shared and well-grounded vision, resulting in robust local renewable energy strategies.},
	urldate = {2024-06-10},
	journal = {Applied Energy},
	author = {Loomans, Naud and Alkemade, Floor},
	month = sep,
	year = {2024},
	keywords = {Decision support tool, Heating transition, Policy support, Smart energy system, Transition pathway},
	pages = {123527},
}

@article{sahooRegionallyIntegratedEnergy2023,
	title = {Regionally integrated energy system detailed spatial analysis: {Groningen} {Province} case study in the northern {Netherlands}},
	volume = {277},
	issn = {0196-8904},
	shorttitle = {Regionally integrated energy system detailed spatial analysis},
	url = {https://www.sciencedirect.com/science/article/pii/S0196890422013772},
	doi = {10.1016/j.enconman.2022.116599},
	abstract = {Regional level energy system analyses and corresponding integrated modeling is necessary to analyze the impact of national energy policies on a regional level, while considering regional constraints related to energy infrastructure, energy supply potentials, sectoral energy demands, and their interactions. Nevertheless, current literature on energy system analysis largely overlooks the regional level. In response, this study provided a systematic approach to refining and improving the spatial resolution of an existing regional energy system modeling framework. The methodology involved creating regions and nodes within the modeling framework under categories corresponding to land use (cities and other regions), energy supply, and energy infrastructure. We established a unidirectional soft linking with geographical information system-based modeling results allocating spatially sensitive elements, such as renewable resources or heat demand. We provided a detailed breakdown of sectoral energy demand, supply options, and energy infrastructure for electricity and heat, including district heating (DH). This framework explicated regional differences in terms of demand–supply mismatch, supply options, and energy infrastructure. Our case study of the Dutch province of Groningen demonstrated clear differences compared to the previous crude regional model, with, e.g., an increased role of biomass (+460 \% change) and decreased role of solar (−59 \%), while cities with high heat demand densities and/or compact structures exhibited serious DH penetration, ranging from 11 to 21 \%. The systematic steps allow for the replication of the model in other regional analyses. Our framework is complementary for energy system analysis at the national and pan-European levels and can assist regional policymakers in decision-making.},
	urldate = {2023-12-18},
	journal = {Energy Conversion and Management},
	author = {Sahoo, Somadutta and van Stralen, Joost N. P. and Zuidema, Christian and Sijm, Jos and Faaij, André},
	month = feb,
	year = {2023},
	keywords = {District heating, Energy infrastructure, Geographical information system, Integrated energy system modeling, Regional energy system, Renewable resources},
	pages = {116599},
}

@misc{taoOptimalEnergyHubAllocation2023,
	address = {Rochester, NY},
	type = {{SSRN} {Scholarly} {Paper}},
	title = {Optimal {Energy}-{Hub} {Allocation} {Based} on {Carbon} {Emission} and {Exergy} {Efficiency} {For} {Regional} {Distribution} {Multi}-{Energy} {Systems}},
	url = {https://papers.ssrn.com/abstract=4533738},
	doi = {10.2139/ssrn.4533738},
	abstract = {The integration and coordinated planning of regional distribution multi-energy systems are of vital significance in achievement of  energy allocation, enhancement of end-used energy efficiency, reduction of  carbon emission and construction of clean low-carbon energy system structure. In this study, a regional distribution multi-energy system optimisation model based on mixed integer second-order cones was proposed, which takes into consideration the three-purpose allocation for regional distribution multi-energy systems in terms of economy, exergy efficiency, and carbon emission. This optimal energy-hub allocation method combines the system's investment and operation costs, carbon emission, and exergy efficiency. At the allocation level, the investment and construction costs of the system are considered, and at the simulation operation level, the optimal configuration strategy for energy stations is considered, which includes the system's operating costs, carbon reduction capacity, and exergy efficiency. In this method, exergy efficiency analysis is used to analyse the efficiency changes of energy hubs, and a multi-objective allocation  model is established for minimising system investment and operating costs, minimising carbon emission, and maximising system exergy efficiency. By adopting second-order cone relaxation technology, the capacity evaluation model makes convex relaxation treatment of the mixed integer non convex nonlinear model and convert it into a mixed integer second-order cone model for solution. In this study, an IEEE33 node distribution network, a 24-node urban gas distribution network, and four distribution energy station with diverse load characteristics were established, and the corresponding simulation testing systems were constructed. Then relevant case analysis was conducted. The test results show that in this study, the allocation model method that regards maximizing system exergy efficiency as the optimisation objective provides a more economical, low-carbon oriented, and efficient operating strategy for the entire system, in comparison with the model that does not take system exergy efficiency into consideration during the planning process.},
	language = {en},
	urldate = {2023-12-18},
	author = {Tao, Jiaxin and Duan, Jiandong and Tuo, Lihao and Lu, Wenchao and Qin, Bo},
	month = aug,
	year = {2023},
	keywords = {Allocation of energy system, Carbon emission, Exergy efficiency, Mixed integer second-order cone optimisation, multi-objective optimisation},
}

