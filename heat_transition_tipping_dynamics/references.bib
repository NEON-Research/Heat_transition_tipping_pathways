}

@article{ravenSpaceScaleSociotechnical2012,
	title = {Space and scale in socio-technical transitions},
	volume = {4},
	issn = {2210-4224},
	url = {https://www.sciencedirect.com/science/article/pii/S2210422412000330},
	doi = {10.1016/j.eist.2012.08.001},
	abstract = {The multi-level perspective (MLP) is a widely adopted framework for analysing stability, change and transitions in socio-technical systems. Key to explanations of change is the interaction between nested levels (niche, regime, landscape) constituting socio-technical systems over time. This paper proposes a second generation, multi-scalar MLP that explicitly incorporates a spatial scale. Recent developments in innovation studies and contributions from regional studies and geography are reviewed. We draw on notions of space as being relational, fluid and contested by institutionally situated actors. Dynamics in socio-technical systems are explained not only by interactions between modes of structuration and developments over time, but also by interactions between actors and institutions situated across different levels of spatial scale. The paper explores the kinds of insights that might emerge from adopting a second generation MLP to socio-technical systems with a case study of biomass gasification in India.},
	language = {en},
	urldate = {2023-04-13},
	journal = {Environmental Innovation and Societal Transitions},
	author = {Raven, Rob and Schot, Johan and Berkhout, Frans},
	month = sep,
	year = {2012},
	keywords = {Multi-level perspective, Multi-scalar MLP, Socio-technical systems, Spatial scale, Transition},
	pages = {63--78},
}

@article{papachristosMultisystemSociotechnicalTransitions2014,
	title = {Towards multi-system sociotechnical transitions: why simulate},
	volume = {26},
	issn = {0953-7325},
	shorttitle = {Towards multi-system sociotechnical transitions},
	url = {https://doi.org/10.1080/09537325.2014.944148},
	doi = {10.1080/09537325.2014.944148},
	abstract = {A number of research frameworks have been developed for studying sociotechnical transitions. These are complex phenomena, particularly those involving multi-system interactions. Given these characteristics, the paper discusses the challenges in studying transitions solely through inductive inference methods. It argues that transition research has reached a point where taking the next step should include modelling and simulation as part of the standard methodological exploratory toolkit for studying the intensity, nature and timing of system interaction that lead to transitions and for producing timely and robust policy recommendations.},
	number = {9},
	urldate = {2023-04-13},
	journal = {Technology Analysis \& Strategic Management},
	publisher = {Routledge},
	author = {Papachristos, George},
	month = oct,
	year = {2014},
	note = {\_eprint: https://doi.org/10.1080/09537325.2014.944148},
	keywords = {complexity, policy, simulation, transitions},
	pages = {1037--1055},
}

@article{holtzUsingAgentBasedModels2020,
	title = {Using {Agent}-{Based} {Models} to {Generate} {Transformation} {Knowledge} for the {German} {Energiewende}—{Potentials} and {Challenges} {Derived} from {Four} {Case} {Studies}},
	volume = {13},
	issn = {1996-1073},
	url = {https://www.mdpi.com/1996-1073/13/22/6133},
	doi = {10.3390/en13226133},
	abstract = {The German Energiewende is a deliberate transformation of an established industrial economy towards a nearly CO2-free energy system accompanied by a phase out of nuclear energy. Its governance requires knowledge on how to steer the transition from the existing status quo to the target situation (transformation knowledge). The energy system is, however, a complex socio-technical system whose dynamics are inﬂuenced by behavioural and institutional aspects, which are badly represented by the dominant techno-economic scenario studies. In this paper, we therefore investigate and identify characteristics of model studies that make agent-based modelling supportive for the generation of transformation knowledge for the Energiewende. This is done by reﬂecting on the experiences gained from four diﬀerent applications of agent-based models. In particular, we analyse whether the studies have improved our understanding of policies’ impacts on the energy system, whether the knowledge derived is useful for practitioners, how valid understanding derived by the studies is, and whether the insights can be used beyond the initial case-studies. We conclude that agent-based modelling has a high potential to generate transformation knowledge, but that the design of projects in which the models are developed and used is of major importance to reap this potential. Well-informed and goal-oriented stakeholder involvement and a strong collaboration between data collection and model development are crucial.},
	language = {en},
	number = {22},
	urldate = {2023-02-17},
	journal = {Energies},
	author = {Holtz, Georg and Schnülle, Christian and Yadack, Malcolm and Friege, Jonas and Jensen, Thorben and Thier, Pablo and Viebahn, Peter and Chappin, Émile J. L.},
	month = nov,
	year = {2020},
	pages = {6133},
}

