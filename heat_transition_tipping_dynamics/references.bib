@article{mullerAnticipationinducedSocialTipping2021,
	title = {Anticipation-induced social tipping: can the environment be stabilised by social dynamics?},
	volume = {230},
	issn = {1951-6401},
	shorttitle = {Anticipation-induced social tipping},
	url = {https://doi.org/10.1140/epjs/s11734-021-00011-5},
	doi = {10.1140/epjs/s11734-021-00011-5},
	abstract = {In the past decades, human activities caused global Earth system changes, e.g., climate change or biodiversity loss. Simultaneously, these associated impacts have increased environmental awareness within societies across the globe, thereby leading to dynamical feedbacks between the social and natural Earth system. Contemporary modelling attempts of Earth system dynamics rarely incorporate such co-evolutions and interactions are mostly studied unidirectionally through direct or remembered past impacts. Acknowledging that societies have the additional capability for foresight, this work proposes a conceptual feedback model of socio-ecological co-evolution with the specific construct of anticipation acting as a mediator between the social and natural system. Our model reproduces results from previous sociological threshold models with bistability if one assumes a static environment. Once the environment changes in response to societal behaviour, the system instead converges towards a globally stable, but not necessarily desired, attractor. Ultimately, we show that anticipation of future ecological states then leads to metastability of the system where desired states can persist for a long time. We thereby demonstrate that foresight and anticipation form an important mechanism which, once its time horizon becomes large enough, fosters social tipping towards behaviour that can stabilise the environment and prevents potential socio-ecological collapse.},
	language = {en},
	number = {16},
	urldate = {2024-07-22},
	journal = {The European Physical Journal Special Topics},
	author = {Müller, Paul Manuel and Heitzig, Jobst and Kurths, Jürgen and Lüdge, Kathy and Wiedermann, Marc},
	month = oct,
	year = {2021},
	pages = {3189--3199},
}

@article{sperlingElectricVehiclesApproaching2018,
	title = {Electric vehicles: {Approaching} the tipping point},
	volume = {74},
	issn = {0096-3402},
	shorttitle = {Electric vehicles},
	url = {https://doi.org/10.1080/00963402.2017.1413055},
	doi = {10.1080/00963402.2017.1413055},
	abstract = {A revolution is underway in transportation, with a variety of electric vehicles rapidly coming to the fore. The switch from internal combustion engines to electric motors will change the world in many ways and is expected to help reduce the world’s carbon dioxide emissions. Inspired by this vision, leaders in China, France, and Britain have all proclaimed that they will effectively ban cars that aren’t electric by about 2040, while Volvo says all of its vehicles will be powered by electric motors in a few years. Other automakers have also announced that they are headed that way. But how far along is this revolution really? What challenges still need to be overcome to gain truly widespread acceptance on a scale that can combat climate change? Will the costs and the benefits of these new vehicles be equally spread among countries and companies? And while we all benefit in the long term, who will be the winners and the losers in our short-term world where Wall Street thinking predominates?},
	number = {1},
	urldate = {2024-07-24},
	journal = {Bulletin of the Atomic Scientists},
	publisher = {Routledge},
	author = {Sperling, Daniel},
	month = jan,
	year = {2018},
	note = {\_eprint: https://doi.org/10.1080/00963402.2017.1413055},
	keywords = {Electric vehicles, batteries, hybrid vehicles, hydrogen fuel cell, plug-in hybrid, zero-emission passenger vehicles},
	pages = {11--18},
}

