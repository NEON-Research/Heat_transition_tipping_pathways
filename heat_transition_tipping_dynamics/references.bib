@article{alkemadeSocialTippingDynamics2023,
	title = {Social tipping dynamics in the energy system},
	url = {https://esd.copernicus.org/preprints/esd-2023-25/},
	doi = {10.5194/esd-2023-25},
	abstract = {{\textless}p{\textgreater}{\textless}strong class="journal-contentHeaderColor"{\textgreater}Abstract.{\textless}/strong{\textgreater} The fast growth in renewables has led to an economic tipping point for the adoption of renewables. However, we do not observe a corresponding reduction in fossil fuel demand. The tipping point has not led to a system-wide energy transition. This paper reviews how the cost tipping point in renewables can initiate other social tipping dynamics in the energy transition and it presents energy communities as a promising and fast-growing niche environment that can exploit and foster such tipping dynamics.{\textless}/p{\textgreater}},
